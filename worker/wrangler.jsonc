{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acres-per-pound",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acres-per-pound",
      "database_id": "ee23e644-83e3-40b4-9fdd-56e6f1acaaf0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "acres-per-pound"
    }
  ],
  "observability": { "enabled": true }
}
